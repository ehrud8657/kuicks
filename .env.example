DJANGO_SECRET_KEY=replace-this-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://kuics:kuics@localhost:5432/kuics
# 배포 시 실제 프론트 주소로 변경 (예: https://kuics-home.com)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# 생략하면 CORS_ALLOWED_ORIGINS와 동일하게 취급됨. 필요할 때만 별도 지정.
# CSRF_TRUSTED_ORIGINS=https://kuics-home.com
# 프론트/백엔드를 서로 다른 서브도메인으로 배포할 때만 true (SameSite=None + HTTPS 쿠키 사용).
# 같은 도메인에서 서빙하면 false(기본값)로 두면 됨.
CROSS_SITE_COOKIES=false
FRONTEND_API_BASE_URL=http://localhost:8000/api

