# 상시 운영 서버용 환경변수 예시.
# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 절대 커밋하지 않습니다.
#
#   Copy-Item .env.prod.example .env      (Windows)
#   cp .env.prod.example .env             (Linux)

# ── 반드시 직접 채워야 하는 값 ────────────────────────────────
# 비워두면 컨테이너가 뜨지 않습니다. (기본값으로 운영되는 사고를 막기 위함)

# Django 서명 키. 아래 명령으로 만들어 붙여넣으세요.
#   docker compose -f docker-compose.prod.yml run --rm backend \
#     python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# DB 비밀번호. 아무 긴 임의 문자열이면 됩니다.
POSTGRES_PASSWORD=

# ── 접속 주소에 맞춰 바꾸는 값 ────────────────────────────────
# 서버에 접속할 도메인 또는 IP. 콤마로 여러 개를 적을 수 있습니다.
# 이 목록에 없는 주소로 들어오면 Django가 요청을 거부합니다.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 브라우저가 보내는 Origin. 프론트와 API가 같은 도메인이므로 접속 주소와 같습니다.
# 이 값이 틀리면 로그인과 비밀번호 변경이 CSRF 오류로 막힙니다.
CORS_ALLOWED_ORIGINS=http://localhost

# HTTPS(도메인 + 인증서)를 붙이기 전까지는 false로 둡니다.
# true인데 http로만 서빙하면 모든 요청이 https로 리다이렉트되어 사이트가 멈추고,
# Secure 쿠키가 전송되지 않아 로그인도 되지 않습니다.
HTTPS_ENABLED=false

# ── 선택 ──────────────────────────────────────────────────
# 80번 포트가 이미 쓰이고 있으면 다른 포트로 바꾸세요. (예: 8080)
# HTTP_PORT=80

# DB 이름과 사용자. 바꿀 이유가 없으면 그대로 두세요.
# POSTGRES_DB=kuics
# POSTGRES_USER=kuics
